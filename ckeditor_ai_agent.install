<?php

/**
 * @file
 * Install, update and uninstall functions for the CKEditor AI Agent module.
 */

use Drupal\Core\Config\FileStorage;
use Drupal\taxonomy\Entity\Vocabulary;
use Drupal\taxonomy\Entity\Term;

/**
 * Implements hook_install().
 */
function ckeditor_ai_agent_install() {
  _ckeditor_ai_agent_create_command_vocabulary();
  _ckeditor_ai_agent_create_tone_vocabulary();
  _ckeditor_ai_agent_update_editor_toolbars();
}

/**
 * Create default AI Agent Commands vocabulary and terms.
 */
function ckeditor_ai_agent_update_9002(): void {
  _ckeditor_ai_agent_create_command_vocabulary();
}

/**
 * Create default AI Tone of Voice vocabulary and terms.
 */
function ckeditor_ai_agent_update_9003(): void {
  _ckeditor_ai_agent_create_tone_vocabulary();
}

/**
 * Add AI Agent buttons to CKEditor5 toolbars.
 */
function ckeditor_ai_agent_update_9004(): void {
  _ckeditor_ai_agent_update_editor_toolbars();
}

/**
 * Helper function to create the command vocabulary and default terms.
 */
function _ckeditor_ai_agent_create_command_vocabulary() {
  // Create vocabulary for commands if it doesn't exist
  $command_vocabulary_name = 'ai_agent_commands';
  $vocabulary_exists = \Drupal::entityTypeManager()
    ->getStorage('taxonomy_vocabulary')
    ->load($command_vocabulary_name);
    
  if (!$vocabulary_exists) {
    // Create vocabulary for commands
    $vocabulary = Vocabulary::create([
      'vid' => $command_vocabulary_name,
      'name' => 'AI Edit Commands',
      'description' => 'Commands for the CKEditor AI Agent editing tools',
    ]);
    $vocabulary->save();
    
    // Define the default command structure
    $default_commands = [
      'Edit or review' => [
        'Polish' => 'Fix spelling mistakes, use proper grammar and apply good writing practices.
Do not lose the original meaning.
You must keep the text formatting.',
        'Improve Tone of Voice' => 'Rewrite the content to match the TONE while preserving the key message and meaning.
Ensure the writing style is consistent.
You must keep the text formatting.',
        'Make Shorter' => 'Remove any repetitive, redundant, or non-essential writing in this
content without changing the meaning or losing any key information.',
        'Make Longer' => 'Improve this content by using descriptive language and inserting
more information and more detailed explanations.
You must keep the text formatting.',
        'Simplify Language' => 'Simplify the writing style of this content and reduce the complexity,
so that the content is easy to understand.
You must keep the text formatting',
      ],
      'Generate from selection' => [
        'Summarize' => 'Summarize this content into one paragraph of text. Include only the key ideas and conclusions.
Keep it short. Do not keep original text formatting',
        'Continue' => 'Start with the provided content and write at the end of it continuing this topic.
Keep the added part short.
You must keep the text formatting',
      ],
    ];
    
    // Create terms for each category and command
    foreach ($default_commands as $category => $commands) {
      // Create the category term
      $category_term = Term::create([
        'vid' => $command_vocabulary_name,
        'name' => $category,
      ]);
      $category_term->save();
      
      // Create each command term as a child of this category
      foreach ($commands as $command_name => $command_instruction) {
        $command_term = Term::create([
          'vid' => $command_vocabulary_name,
          'name' => $command_name,
          'description' => $command_instruction,
          'parent' => [$category_term->id()],
        ]);
        $command_term->save();
      }
    }
    
    // Update the module configuration to use this vocabulary
    $config = \Drupal::configFactory()->getEditable('ckeditor_ai_agent.settings');
    $config->set('commandsVocabulary', $command_vocabulary_name);
    $config->save();
  }
}

/**
 * Helper function to create the tone of voice vocabulary and default terms.
 */
function _ckeditor_ai_agent_create_tone_vocabulary() {
  // Create vocabulary for tones if it doesn't exist
  $tone_vocabulary_name = 'ai_tone_of_voice';
  $vocabulary_exists = \Drupal::entityTypeManager()
    ->getStorage('taxonomy_vocabulary')
    ->load($tone_vocabulary_name);
    
  if (!$vocabulary_exists) {
    // Create vocabulary for tones
    $vocabulary = Vocabulary::create([
      'vid' => $tone_vocabulary_name,
      'name' => 'AI Tone of Voice',
      'description' => 'Tones of voice for the CKEditor AI Agent',
    ]);
    $vocabulary->save();
    
    // Define the default tones
    $default_tones = [
      'Professional' => 'Use clear, concise language with a business-appropriate tone suitable for formal contexts.',
      'Educational' => 'Explain concepts clearly with an informative approach that helps readers understand complex topics.',
      'Persuasive' => 'Use compelling language to convince readers and support arguments with strong reasoning.',
      'Approachable' => 'Write in a friendly and accessible manner while maintaining professionalism.',
      'Formal' => 'Employ precise, structured language appropriate for official documentation and communications.',
      'Inspirational' => 'Use motivational language that encourages action and creates a sense of possibility.',
    ];
    
    // Create terms for each tone
    foreach ($default_tones as $tone_name => $tone_description) {
      $tone_term = Term::create([
        'vid' => $tone_vocabulary_name,
        'name' => $tone_name,
        'description' => $tone_description,
      ]);
      $tone_term->save();
    }
    
    // Update the module configuration to use this vocabulary
    $config = \Drupal::configFactory()->getEditable('ckeditor_ai_agent.settings');
    $config->set('toneOfVoiceVocabulary', $tone_vocabulary_name);
    $config->save();
  }
}

/**
 * Helper function to update CKEditor5 toolbars with AI Agent buttons.
 */
function _ckeditor_ai_agent_update_editor_toolbars() {
  $config_factory = \Drupal::configFactory();
  $editor_formats = ['basic_html', 'full_html', 'content_format'];

  foreach ($editor_formats as $format_id) {
    $editor_config_name = 'editor.editor.' . $format_id;
    $editor_config = $config_factory->getEditable($editor_config_name);

    if (!$editor_config->isNew()) {
      $settings = $editor_config->get('settings');
      if (isset($settings['toolbar']['items'])) {
        // Check if buttons are already present to avoid duplicates
        if (!in_array('aiAgentButton', $settings['toolbar']['items'])) {
          // Add AI buttons to the beginning of the toolbar
          array_unshift($settings['toolbar']['items'], '|');
          array_unshift($settings['toolbar']['items'], 'aiAgentToneButton');
          array_unshift($settings['toolbar']['items'], 'aiAgentButton');
          $editor_config->set('settings.toolbar.items', $settings['toolbar']['items']);
          $editor_config->save();
        }
      }
    }
  }
}

/**
 * Migrate API keys to Key module if available.
 */
function ckeditor_ai_agent_update_9001(): void {
  if (!\Drupal::moduleHandler()->moduleExists('key')) {
    return;
  }

  $config_factory = \Drupal::configFactory();
  $entity_type_manager = \Drupal::entityTypeManager();
  $key_repository = \Drupal::service('key.repository');

  // Migrate global settings key
  $settings = $config_factory->getEditable('ckeditor_ai_agent.settings');
  $api_key = $settings->get('apiKey');
  if ($api_key) {
    // Create a new key entity
    $values = [
      'id' => 'ckeditor_ai_agent_key',
      'label' => 'CKEditor AI Agent API Key',
      'key_type' => 'authentication',
      'key_provider' => 'config',
      'key_provider_settings' => [
        'key_value' => $api_key,
      ],
      'key_input' => 'text_field',
    ];
    $storage = $entity_type_manager->getStorage('key');
    $key = $storage->create($values);
    $key->save();

    // Update settings to use the key
    $settings
      ->set('api_key_storage', 'key')
      ->set('key_provider', 'ckeditor_ai_agent_key')
      ->set('apiKey', NULL)
      ->save();
  }

  // Migrate editor-specific keys
  $editors = $entity_type_manager->getStorage('editor')->loadMultiple();
  foreach ($editors as $editor) {
    $settings = $editor->getSettings();
    if (isset($settings['plugins']['aiagent']['apiKey'])) {
      $api_key = $settings['plugins']['aiagent']['apiKey'];
      if ($api_key) {
        // Create a new key entity
        $key_id = 'ckeditor_ai_agent_key_' . $editor->id();
        $values = [
          'id' => $key_id,
          'label' => 'CKEditor AI Agent API Key - ' . $editor->label(),
          'key_type' => 'authentication',
          'key_provider' => 'config',
          'key_provider_settings' => [
            'key_value' => $api_key,
          ],
          'key_input' => 'text_field',
        ];
        $storage = $entity_type_manager->getStorage('key');
        $key = $storage->create($values);
        $key->save();

        // Update editor settings
        $settings['plugins']['aiagent']['api_key_storage'] = 'key';
        $settings['plugins']['aiagent']['key_provider'] = $key_id;
        $settings['plugins']['aiagent']['apiKey'] = NULL;
        $editor->setSettings($settings);
        $editor->save();
      }
    }
  }

  // Clear caches to ensure new services are discovered
  drupal_flush_all_caches();
} 