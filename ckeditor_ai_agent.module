<?php

/**
 * @file
 * Contains ckeditor_ai_agent.module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\ckeditor_ai_agent\Hook\CkeditorAiAgentHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_ckeditor5_plugin_info_alter().
 *
 * @phpstan-param \Drupal\ckeditor5\Plugin\CKEditor5PluginDefinition[] $plugin_definitions
 */
#[LegacyHook]
function ckeditor_ai_agent_ckeditor5_plugin_info_alter(array &$plugin_definitions): void {
  \Drupal::service(CkeditorAiAgentHooks::class)->ckeditor5PluginInfoAlter($plugin_definitions);
}

/**
 * Implements hook_ai_brand_voice_alter().
 */
#[LegacyHook]
function ckeditor_ai_agent_ai_brand_voice_alter(string &$brand_voice) {
  \Drupal::service(CkeditorAiAgentHooks::class)->aiBrandVoiceAlter($brand_voice);
}

/**
 * Implements hook_help().
 */
#[LegacyHook]
function ckeditor_ai_agent_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(CkeditorAiAgentHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_page_attachments_alter().
 */
#[LegacyHook]
function ckeditor_ai_agent_page_attachments_alter(array &$attachments) {
  \Drupal::service(CkeditorAiAgentHooks::class)->pageAttachmentsAlter($attachments);
}

/**
 * Implements hook_runtime_requirements().
 */
function ckeditor_ai_agent_runtime_requirements(): array {
  // Drupal 11.2 still invokes the legacy requirements hook.
  if (version_compare(\Drupal::VERSION, '11.3.0', '<')) {
    return [];
  }
  \Drupal::moduleHandler()->loadInclude('ckeditor_ai_agent', 'install');
  return ckeditor_ai_agent_requirements('runtime');
}
