<?php

/**
 * @file
 * Contains ckeditor_ai_agent.module.
 */

use Drupal\ckeditor5\Plugin\CKEditor5PluginDefinition;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;

/**
 * Implements hook_ckeditor5_plugin_info_alter().
 *
 * @phpstan-param \Drupal\ckeditor5\Plugin\CKEditor5PluginDefinition[] $plugin_definitions
 */
function ckeditor_ai_agent_ckeditor5_plugin_info_alter(array &$plugin_definitions): void {
  if (isset($plugin_definitions['ckeditor_ai_agent_ai_agent'])) {
    /** @var \Drupal\ckeditor_ai_agent\AiAgentConfigurationManager $config_manager */
    $config_manager = \Drupal::service('ckeditor_ai_agent.configuration_manager');

    /** @var \Drupal\ckeditor5\Plugin\CKEditor5PluginDefinition $definition */
    $definition = $plugin_definitions['ckeditor_ai_agent_ai_agent'];
    $plugin_config = $definition->toArray();

    // Get existing config or initialize empty array.
    $config = $plugin_config['ckeditor5']['config'] ?? [];

    // Get the current editor entity from the route.
    $editor = NULL;
    $route_match = \Drupal::routeMatch();
    if ($route_match instanceof RouteMatchInterface) {
      $editor = $route_match->getParameter('editor');
    }

    // Get our configuration
    $our_config = $config_manager->getCKEditorConfig($editor);

    // Merge with our configuration.
    $config = array_merge($config, $our_config);

    // Update the plugin configuration.
    $plugin_config['ckeditor5']['config'] = $config;

    // Create new definition with updated config.
    $plugin_definitions['ckeditor_ai_agent_ai_agent'] = new CKEditor5PluginDefinition($plugin_config);
  }
}

/**
 * Implements hook_ai_brand_voice_alter().
 */
function ckeditor_ai_agent_ai_brand_voice_alter(string &$brand_voice) {
  $config = \Drupal::config('ckeditor_ai_agent.settings');
  $tone_override = $config->get('promptSettings.overrides.tone');
  $tone_additions = $config->get('promptSettings.additions.tone');

  if (!empty($tone_override)) {
    $brand_voice = $tone_override;
    if (!empty($tone_additions)) {
      $brand_voice .= "\n\n" . $tone_additions;
    }
  }
}

/**
 * Implements hook_help().
 */
function ckeditor_ai_agent_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.ckeditor_ai_agent':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The CKEditor AI Agent module adds AI-powered content generation capabilities to CKEditor 5.') . '</p>';
      return $output;
  }
}

/**
 * Implements hook_requirements().
 */
function ckeditor_ai_agent_requirements($phase) {
  $requirements = [];

  if ($phase === 'runtime') {
    $key_exists = \Drupal::moduleHandler()->moduleExists('key');
    $config = \Drupal::config('ckeditor_ai_agent.settings');
    $key_service = \Drupal::service('ckeditor_ai_agent.key_service');

    if (!$key_exists) {
      $requirements['ckeditor_ai_agent_key'] = [
        'title' => t('CKEditor AI Agent'),
        'description' => t('The Key module is required but not installed. Please install and enable the <a href="@url">Key module</a>.', [
          '@url' => 'https://www.drupal.org/project/key',
        ]),
        'severity' => REQUIREMENT_ERROR,
      ];
    }
    elseif (!$key_service->getApiKey()) {
      $requirements['ckeditor_ai_agent_key'] = [
        'title' => t('CKEditor AI Agent'),
        'description' => t('No API key has been configured. Please configure an API key in the <a href="@url">module settings</a>.', [
          '@url' => Url::fromRoute('ckeditor_ai_agent.settings')->toString(),
        ]),
        'severity' => REQUIREMENT_ERROR,
      ];
    }
    else {
      $requirements['ckeditor_ai_agent_key'] = [
        'title' => t('CKEditor AI Agent'),
        'description' => t('API key is configured and stored securely.'),
        'severity' => REQUIREMENT_OK,
      ];
    }
  }

  return $requirements;
}

/**
 * Implements hook_page_attachments_alter().
 */
function ckeditor_ai_agent_page_attachments_alter(array &$attachments) {
  // This implementation is no longer needed as we're handling tones directly in the AiAgent plugin
}
